# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only, JANGAN diberi awalan NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# URL publik situs (dipakai untuk callback webhook gateway)
APP_URL=https://heroitbest.com

# Nomor WhatsApp admin, format 628xxxxxxxxxx (tanpa + / spasi)
NEXT_PUBLIC_ADMIN_WHATSAPP_NUMBER=

# Kode rahasia untuk halaman /setup-admin (buat admin pertama lewat web). Kosongkan setelah admin jadi.
SETUP_ADMIN_SECRET=

# Opsional: kredensial GensPay. Lebih baik diisi lewat Admin -> GensPay
# (tersimpan di database, bisa diganti tanpa redeploy). Env ini hanya fallback.
GENSPAY_BASE_URL=
GENSPAY_API_KEY=

# Pakasir API v2 (opsional; bisa juga diisi dari Admin -> Pakasir). API v1 dihentikan 20 Okt 2026.
# Slug + API Key + Secret ada di bagian bawah halaman Detail Proyek app.pakasir.com.
PAKASIR_SLUG=
PAKASIR_API_KEY=
PAKASIR_WEBHOOK_SECRET=
PAKASIR_BASE_URL=https://app.pakasir.com

# --- Cloudflare Turnstile (opsional tapi disarankan) ---
# Buat widget di dash.cloudflare.com -> Turnstile. Site key = publik (boleh NEXT_PUBLIC_).
# Secret key = RAHASIA, jangan pakai awalan NEXT_PUBLIC_.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Untuk LOGIN: aktifkan juga di Supabase -> Authentication -> Attack Protection ->
# "Enable CAPTCHA protection" -> Turnstile -> tempel secret key yang sama.

# ── Toko link seller (/s/<slug>) ────────────────────────────────
# Kunci enkripsi untuk API key GensPay milik seller. Bikin sekali:
#   openssl rand -hex 32
# JANGAN diganti setelah ada seller menyimpan key (key lama tidak bisa dibuka lagi).
# Kosong = fitur toko seller mati.
STORE_SECRET_KEY=
# (APP_URL di atas juga dipakai sebagai alamat callback pembayaran GensPay seller -- isi dengan domain situs ini.)

# Supplier kedua: CHEATGAME.ONLINE (CGS) -- bisa juga diisi lewat Admin > Reseller API
CHEATGAME_API_KEY=
CHEATGAME_BASE_URL=https://cheatgame.online/reseller_api.php

# WijayaPay QRIS (gateway.wijayapay.com) -- bisa juga diisi lewat Admin > WijayaPay
WIJAYAPAY_MERCHANT_CODE=
WIJAYAPAY_API_KEY=
WIJAYAPAY_BASE_URL=https://gateway.wijayapay.com

# Fitur seller/marketplace. Default MATI (sistem ala vipbestmods: admin isi produk & key).
# Isi true lalu redeploy untuk menyalakan lagi -- data seller tidak dihapus.
SELLER_ENABLED=false
